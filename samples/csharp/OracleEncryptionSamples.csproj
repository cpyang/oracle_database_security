<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oracle-encryption-samples</AssemblyName>
    <StartupObject>OracleEncryptionSamples.Program</StartupObject>
    <Version>1.0.0</Version>
    <Description>Oracle Data Security - Application-level encryption samples (C#)</Description>
    <Company>Oracle Data Security Team</Company>
    <Authors>Oracle Data Security Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Oracle Data Provider for .NET (ODP.NET Core) for database integration -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.5.0" />
  </ItemGroup>

</Project>
